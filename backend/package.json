{
  "name": "stockpadi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StockPadi backend: Postgres migrations, RLS policies, and Supabase Edge Functions. Split from the original monorepo's supabase/ directory — see docs/BACKEND-SPLIT.md.",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@stockpadi/contracts": "file:../packages/contracts",
    "@supabase/supabase-js": "^2.112.2",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  },
  "scripts": {
    "prebuild": "npm --prefix ../packages/contracts run build",
    "build": "tsc",
    "start": "npm run build && node --env-file=.env dist/src/server.js",
    "provision:admin": "node --env-file=.env scripts/provision-platform-admin.mjs",
    "pretest": "npm --prefix ../packages/contracts run build",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "npm --prefix ../packages/contracts run build",
    "typecheck": "tsc --noEmit",
    "seed:owner": "node --env-file=.env scripts/seed-owner.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "reset:password": "node scripts/reset-password.mjs",
    "confirm:users": "node scripts/confirm-users.mjs",
    "check:confirmation": "node scripts/check-confirmation.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
