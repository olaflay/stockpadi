# Backend configuration template.
# Replace placeholder values locally. Never commit backend/.env.

PORT=8787
FRONTEND_ORIGIN=http://localhost:3000
# For multiple deployed frontend URLs, use a comma-separated allow-list.
# Example: http://localhost:3000,https://stockpadi-drab.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,https://stockpadi-drab.vercel.app
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Email Delivery Configuration (Brevo REST API or Brevo SMTP Relay)
# Option A: Brevo REST API v3 (Recommended for serverless & edge environments)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL="StockPadi <noreply@yourdomain.com>"

# Option B: Brevo / Standard SMTP Relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
SMTP_FROM="StockPadi <noreply@yourdomain.com>"

# Development only. Keep false in production.
DEV_LOG_VERIFICATION_CODES=false

# Optional private Admin provisioning values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_FULL_NAME=StockPadi Admin
