# Backend configuration template.
# Replace placeholder values locally. Never commit backend/.env.

PORT=8787
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# SMTP is used for verification and Worker credential emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="StockPadi <noreply@example.com>"

# Development only. Keep false in production.
DEV_LOG_VERIFICATION_CODES=false

# Optional private Admin provisioning values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_FULL_NAME=StockPadi Admin
