# Used only by `supabase functions serve` for local Edge Function testing.
# Never commit real values; copy this to .env.local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Brevo REST API v3 (Recommended)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL="StockPadi <noreply@yourdomain.com>"

# Or SMTP Relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
SMTP_FROM="StockPadi <noreply@yourdomain.com>"

NODE_ENV=development
DEV_LOG_VERIFICATION_CODES=true
