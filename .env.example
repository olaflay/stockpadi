# Supabase Cloud project for THIS deployment only.
# Per .agents/rules/reusability-and-multi-client.md: never commit real values here,
# never share these across two client deployments.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (Edge Functions, migrations). Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Must point at Supavisor in session mode (Supabase Cloud's connection pooler,
# the "Session mode" URI from Project Settings > Database, not Postgres's own
# direct connection string) — see .agents/rules/hosting-and-deployment.md. src/lib/db-pool.ts
# opens up to 10 connections per Next.js server process; against a direct
# (unpooled) connection string this can exhaust Postgres's default
# max_connections quickly once Supabase's own internal services (PostgREST,
# Realtime, Auth) are added in, especially under concurrent load.
SUPABASE_DB_URL=

# Branding layer for this deployment only. See .agents/rules/reusability-and-multi-client.md.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BRAND_ACCENT_COLOR=
NEXT_PUBLIC_BRAND_LOGO_URL=

# SMTP configuration for transactional email (verification code + welcome email).
# Used by supabase/functions/send-verification and supabase/functions/verify-email
# via the shared mailer at supabase/functions/_shared/mailer.ts.
# Set these as Supabase Edge Function secrets via `npx supabase secrets set` or the
# Supabase dashboard (never in .env files on the server).
#
# Provider quick-reference:
#   Resend  → SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend
#   Brevo   → SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#   Gmail   → SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=your@gmail.com
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockPadi <noreply@yourdomain.com>"

