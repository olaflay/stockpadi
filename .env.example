# StockPadi uses separate environment files for each deployable application.
# This root file is documentation only; the apps do not load it.
#
# Frontend: copy frontend/.env.example to frontend/.env.local
# Backend:  copy backend/.env.example to backend/.env
#
# Never put real secrets in this file. Never commit backend/.env or
# frontend/.env.local.

FRONTEND_ENV_FILE=frontend/.env.local
BACKEND_ENV_FILE=backend/.env
